#!/usr/bin/env python3
# file_dedup.py
# duplicate finder + integrity checker. uses a cuckoo filter for the
# "have I seen this hash before" check.
#
#   python file_dedup.py scan folderA folderB                       (dry run, just report)
#   python file_dedup.py scan folderA --action hardlink --apply     (really do it)
#   python file_dedup.py manifest folderA -o manifest.json          (save hashes of everything)
#   python file_dedup.py verify manifest.json folderA               (check nothing changed)

import argparse
import csv
import filecmp
import fnmatch
import hashlib
import json
import os
import random
import shutil
import stat
import sys
import time
from collections import defaultdict, namedtuple
from concurrent.futures import ThreadPoolExecutor

FileInfo = namedtuple("FileInfo", "path size mtime_ns dev ino")

PARTIAL_BYTES = 64 * 1024  # how much of the start/end we read for the cheap hash


def log(*args):
    print(*args, file=sys.stderr)


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{int(n)} B" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


# ---------------------------------------------------------------- cuckoo filter

class CuckooFilter:
    """bucket_size slots per bucket, fp_bits bit fingerprints, partial-key cuckoo hashing.
    If an insert runs out of kicks the homeless fingerprint goes into a one-slot
    stash instead of being thrown away, so there are never false negatives."""

    def __init__(self, capacity=100_000, bucket_size=4, fp_bits=16, max_kicks=500):
        self.bucket_size = bucket_size
        self.fp_bits = fp_bits
        self.max_kicks = max_kicks
        need = max(1, -(-capacity // bucket_size))        # ceil division
        self.num_buckets = 1 << (need - 1).bit_length()   # power of 2 so xor trick works
        self.mask = self.num_buckets - 1
        self.buckets = [[] for _ in range(self.num_buckets)]
        self.count = 0
        self.stash = None  # (fingerprint, bucket index) or None

    def _locate(self, key):
        if isinstance(key, str):
            key = key.encode()
        d = hashlib.blake2b(key, digest_size=12).digest()
        fp = (int.from_bytes(d[:4], "big") & ((1 << self.fp_bits) - 1)) or 1  # 0 not allowed
        i1 = int.from_bytes(d[4:], "big") & self.mask
        return fp, i1, self._alt(i1, fp)

    def _alt(self, i, fp):
        # xor with a hash of the fingerprint. doing it twice gives the original index
        h = (fp * 0x9E3779B1) & 0xFFFFFFFF
        h ^= h >> 15
        return (i ^ h) & self.mask

    @property
    def full(self):
        return self.stash is not None

    @property
    def load_factor(self):
        return self.count / (self.num_buckets * self.bucket_size)

    def insert(self, key):
        if self.full:
            return False
        fp, i1, i2 = self._locate(key)
        for i in (i1, i2):
            if len(self.buckets[i]) < self.bucket_size:
                self.buckets[i].append(fp)
                self.count += 1
                return True

        # both buckets full -> kick things around
        i = random.choice((i1, i2))
        for _ in range(self.max_kicks):
            j = random.randrange(self.bucket_size)
            fp, self.buckets[i][j] = self.buckets[i][j], fp
            i = self._alt(i, fp)
            if len(self.buckets[i]) < self.bucket_size:
                self.buckets[i].append(fp)
                self.count += 1
                return True

        self.stash = (fp, i)   # keep it, filter is basically full now
        self.count += 1
        return True

    def contains(self, key):
        fp, i1, i2 = self._locate(key)
        if fp in self.buckets[i1] or fp in self.buckets[i2]:
            return True
        return self.stash is not None and self.stash[0] == fp and self.stash[1] in (i1, i2)

    def delete(self, key):
        fp, i1, i2 = self._locate(key)
        for i in (i1, i2):
            if fp in self.buckets[i]:
                self.buckets[i].remove(fp)
                self.count -= 1
                self._retry_stash()
                return True
        if self.stash is not None and self.stash[0] == fp and self.stash[1] in (i1, i2):
            self.stash = None
            self.count -= 1
            return True
        return False

    def _retry_stash(self):
        # a delete freed a slot, maybe the stashed fingerprint fits now
        if self.stash is None:
            return
        fp, i = self.stash
        for idx in (i, self._alt(i, fp)):
            if len(self.buckets[idx]) < self.bucket_size:
                self.buckets[idx].append(fp)
                self.stash = None
                return


# ---------------------------------------------------------------- hashing / walking

def full_hash(path, chunk=1024 * 1024):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            block = f.read(chunk)
            if not block:
                break
            h.update(block)
    return h.hexdigest()


def partial_hash(path, size):
    # cheap hash: first + last 64KB (or the whole thing if it's small)
    h = hashlib.sha256()
    with open(path, "rb") as f:
        if size <= 2 * PARTIAL_BYTES:
            h.update(f.read())
        else:
            h.update(f.read(PARTIAL_BYTES))
            f.seek(-PARTIAL_BYTES, os.SEEK_END)
            h.update(f.read(PARTIAL_BYTES))
    return h.hexdigest()


def cached_digest(f, cache):
    # reuse an old hash if size and mtime haven't changed
    hit = cache.get(f.path)
    if hit and hit["size"] == f.size and hit["mtime_ns"] == f.mtime_ns:
        return hit["sha256"]
    d = full_hash(f.path)
    cache[f.path] = {"size": f.size, "mtime_ns": f.mtime_ns, "sha256": d}
    return d


def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, path)


def is_excluded(path, name, patterns):
    return any(fnmatch.fnmatch(name, p) or fnmatch.fnmatch(path, p) for p in patterns)


def collect(folders, min_size, excludes, errors):
    """yield FileInfo for every regular file (symlinks skipped, overlapping folders handled)"""
    seen_real = set()
    for folder in folders:
        for root, dirs, names in os.walk(folder):
            dirs[:] = [d for d in dirs if not is_excluded(os.path.join(root, d), d, excludes)]
            for name in names:
                p = os.path.abspath(os.path.join(root, name))
                if is_excluded(p, name, excludes):
                    continue
                try:
                    if os.path.islink(p):
                        continue
                    st = os.stat(p)
                except OSError as e:
                    errors.append((p, str(e)))
                    continue
                if not stat.S_ISREG(st.st_mode) or st.st_size < min_size:
                    continue
                real = os.path.realpath(p)
                if real in seen_real:
                    continue
                seen_real.add(real)
                yield FileInfo(p, st.st_size, st.st_mtime_ns, st.st_dev, st.st_ino)


def parallel_map(func, items, threads, errors):
    # results come back in the same order as items, None if that item failed
    def safe(item):
        try:
            return func(item)
        except OSError as e:
            errors.append((item.path, str(e)))
            return None

    with ThreadPoolExecutor(max_workers=max(1, threads)) as ex:
        return list(ex.map(safe, items))


# ---------------------------------------------------------------- dedup

class Skip(Exception):
    pass


class Group:
    def __init__(self, digest, keep, dups):
        self.digest = digest
        self.keep = keep
        self.dups = dups
        self.verified = []   # dups that passed the byte-for-byte check
        self.failed = []


def pick_order(policy):
    if policy == "oldest":
        return lambda f: (f.mtime_ns, f.path)
    if policy == "newest":
        return lambda f: (-f.mtime_ns, f.path)
    if policy == "shortest":
        return lambda f: (len(f.path), f.path)
    return lambda f: f.path  # "first" = alphabetical


class Deduper:
    def __init__(self, capacity=100_000, threads=4, cache=None, quiet=True):
        self.capacity = capacity
        self.threads = threads
        self.cache = cache if cache is not None else {}
        self.filter = CuckooFilter(capacity)
        self.say = (lambda *a: None) if quiet else log
        self.errors = []
        self.groups = []
        self.actions = []
        self.stats = defaultdict(int)
        self._raw = {}   # digest -> [FileInfo]

    # ---- stage by stage: size -> partial hash -> full hash
    def scan(self, folders, min_size=1, excludes=()):
        t0 = time.perf_counter()
        files = list(collect(folders, min_size, excludes, self.errors))
        self.stats["files_scanned"] = len(files)
        self.say(f"found {len(files)} files")

        by_size = defaultdict(list)
        for f in files:
            by_size[f.size].append(f)

        candidates = []
        for group in by_size.values():
            # hardlinks to the same inode already share data, only count one of them
            unique = {}
            for f in group:
                unique.setdefault((f.dev, f.ino) if f.ino else f.path, f)
            self.stats["already_hardlinked"] += len(group) - len(unique)
            if len(unique) > 1:
                candidates.extend(unique.values())
        self.say(f"{len(candidates)} files share a size with another file")

        # partial hash
        self.stats["partial_hashed"] = len(candidates)
        partials = parallel_map(lambda f: partial_hash(f.path, f.size), candidates,
                                self.threads, self.errors)
        buckets = defaultdict(list)
        for f, ph in zip(candidates, partials):
            if ph is not None:
                buckets[(f.size, ph)].append(f)
        candidates = [f for g in buckets.values() if len(g) > 1 for f in g]
        self.say(f"{len(candidates)} files still look the same after partial hash")

        # full hash + cuckoo filter
        self.stats["full_hashed"] = len(candidates)
        digests = parallel_map(lambda f: cached_digest(f, self.cache), candidates,
                               self.threads, self.errors)
        raw = {}
        for f, d in zip(candidates, digests):
            if d is None:
                continue
            is_new = True
            if self.filter.contains(d):
                if d in raw:
                    is_new = False          # real duplicate
                else:
                    self.stats["filter_false_positives"] += 1   # filter was wrong, dict knows better
            if is_new:
                self._filter_insert(d, raw)
            raw.setdefault(d, []).append(f)
        self._raw = {d: m for d, m in raw.items() if len(m) > 1}
        self.say(f"scan took {time.perf_counter() - t0:.2f}s")

    def _filter_insert(self, digest, known):
        if not self.filter.insert(digest):
            # filter is full -> rebuild it twice as big from the digests we already know
            self.capacity *= 2
            bigger = CuckooFilter(self.capacity)
            for d in known:
                bigger.insert(d)
            self.filter = bigger
            self.stats["filter_rebuilds"] += 1
            self.filter.insert(digest)

    # ---- pick which file to keep and double check each duplicate
    def resolve(self, keep="oldest"):
        filecmp.clear_cache()
        order = pick_order(keep)
        self.groups = []
        for digest, members in self._raw.items():
            ordered = sorted(members, key=order)
            g = Group(digest, ordered[0], ordered[1:])
            for dup in g.dups:
                same = (dup.size == g.keep.size and
                        filecmp.cmp(g.keep.path, dup.path, shallow=False))
                (g.verified if same else g.failed).append(dup)
            self.groups.append(g)
        self.groups.sort(key=lambda g: -g.keep.size * len(g.dups))

    # ---- actions
    def apply(self, action="report", really=False, quarantine="dedup_quarantine"):
        self.actions = []
        if action == "report":
            return
        for g in self.groups:
            for dup in g.verified:
                rec = {"action": action, "keep": g.keep.path, "dup": dup.path,
                       "size": dup.size, "done": False, "note": ""}
                if not really:
                    rec["note"] = "dry run"
                else:
                    try:
                        self._check_unchanged(g.keep, dup)
                        rec["dest"] = self._do(action, g, dup, quarantine)
                        rec["done"] = True
                    except (OSError, Skip) as e:
                        rec["note"] = str(e)
                self.actions.append(rec)

    @staticmethod
    def _check_unchanged(keep, dup):
        # files could have changed between the scan and now, never trust old info
        for f in (keep, dup):
            st = os.stat(f.path)
            if st.st_size != f.size or st.st_mtime_ns != f.mtime_ns:
                raise Skip(f"changed since scan: {f.path}")
        if os.path.samefile(keep.path, dup.path):
            raise Skip("already the same file")

    @staticmethod
    def _do(action, g, dup, quarantine):
        if action == "delete":
            os.remove(dup.path)
            return None
        if action == "move":
            os.makedirs(quarantine, exist_ok=True)
            dest = os.path.join(quarantine, g.digest[:12] + "_" + os.path.basename(dup.path))
            shutil.move(dup.path, dest)
            return dest
        # hardlink / symlink: make the link under a temp name, then swap it in
        # so the duplicate is never missing, even if we crash halfway
        tmp = dup.path + ".dedup_tmp"
        try:
            if action == "hardlink":
                os.link(g.keep.path, tmp)
            else:
                os.symlink(g.keep.path, tmp)
            os.replace(tmp, dup.path)
        finally:
            if os.path.lexists(tmp):
                os.remove(tmp)
        return g.keep.path

    # ---- reporting
    def summary(self):
        dups = [d for g in self.groups for d in g.dups]
        ok = [d for g in self.groups for d in g.verified]
        s = dict(self.stats)
        s.update({
            "duplicate_groups": len(self.groups),
            "duplicate_files": len(dups),
            "verified_duplicates": len(ok),
            "failed_verification": len(dups) - len(ok),
            "reclaimable_bytes": sum(d.size for d in ok),
            "filter_load_factor": round(self.filter.load_factor, 3),
            "errors": len(self.errors),
        })
        return s

    def report(self):
        return {
            "summary": self.summary(),
            "groups": [{"sha256": g.digest, "size": g.keep.size, "keep": g.keep.path,
                        "duplicates": [d.path for d in g.verified],
                        "failed_verification": [d.path for d in g.failed]}
                       for g in self.groups],
            "actions": self.actions,
            "errors": self.errors,
        }


def write_report(path, report):
    if path.lower().endswith(".csv"):
        with open(path, "w", newline="") as fh:
            w = csv.writer(fh)
            w.writerow(["sha256", "size", "role", "path"])
            for g in report["groups"]:
                w.writerow([g["sha256"], g["size"], "keep", g["keep"]])
                for d in g["duplicates"]:
                    w.writerow([g["sha256"], g["size"], "duplicate", d])
    else:
        save_json(path, report)


# ---------------------------------------------------------------- manifest / verif

def build_manifest(folders, excludes=(), threads=4, cache=None):
    errors = []
    cache = cache if cache is not None else {}
    files = list(collect(folders, 0, excludes, errors))
    digests = parallel_map(lambda f: cached_digest(f, cache), files, threads, errors)
    entries = {f.path: {"sha256": d, "size": f.size, "mtime_ns": f.mtime_ns}
               for f, d in zip(files, digests) if d}
    return {"created": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "roots": [os.path.abspath(x) for x in folders],
            "files": entries, "errors": errors}


def verify_manifest(manifest, folders, excludes=(), threads=4, fast=False):
    """compare folders against a manifest. fast=True trusts size+mtime (no rehash)."""
    errors = []
    roots = [os.path.abspath(x) for x in folders]
    in_scope = lambda p: any(p == r or p.startswith(r + os.sep) for r in roots)
    old = {p: e for p, e in manifest["files"].items() if in_scope(p)}
    cur = {f.path: f for f in collect(folders, 0, excludes, errors)}

    res = {"ok": [], "modified": [], "corrupted": [], "missing": [],
           "new": [], "moved": [], "errors": errors}

    both = [cur[p] for p in old if p in cur]

    def check(f):
        e = old[f.path]
        if fast and e["size"] == f.size and e["mtime_ns"] == f.mtime_ns:
            return e["sha256"]
        return full_hash(f.path)

    for f, d in zip(both, parallel_map(check, both, threads, errors)):
        e = old[f.path]
        if d is None:
            continue
        if d == e["sha256"]:
            res["ok"].append(f.path)
        elif f.size == e["size"] and f.mtime_ns == e["mtime_ns"]:
            res["corrupted"].append(f.path)   # content changed but mtime didn't -> suspicious
        else:
            res["modified"].append(f.path)

    missing = [p for p in old if p not in cur]
    new = [cur[p] for p in cur if p not in old]

    # a "new" file whose hash matches a missing one is probably just moved/renamed
    if missing and new:
        gone = defaultdict(list)
        for p in missing:
            gone[(old[p]["sha256"], old[p]["size"])].append(p)
        for f, d in zip(new, parallel_map(lambda f: full_hash(f.path), new, threads, errors)):
            if d is not None and gone.get((d, f.size)):
                res["moved"].append((gone[(d, f.size)].pop(0), f.path))
            else:
                res["new"].append(f.path)
        moved_from = {a for a, _ in res["moved"]}
        res["missing"] = [p for p in missing if p not in moved_from]
    else:
        res["missing"] = missing
        res["new"] = [f.path for f in new]
    return res


# ---------------------------------------------------------------- command line

def cmd_scan(a):
    cache = load_json(a.cache, {}) if a.cache else {}
    d = Deduper(capacity=a.capacity, threads=a.threads, cache=cache, quiet=a.quiet)
    d.scan(a.folders, min_size=a.min_size, excludes=a.exclude)
    d.resolve(keep=a.keep)
    d.apply(a.action, really=a.apply, quarantine=a.quarantine)
    if a.cache:
        save_json(a.cache, cache)

    s = d.summary()
    print(f"files scanned:        {s['files_scanned']}")
    print(f"duplicate groups:     {s['duplicate_groups']}")
    print(f"duplicate files:      {s['duplicate_files']} "
          f"({s['verified_duplicates']} verified byte-for-byte, {s['failed_verification']} failed)")
    print(f"reclaimable space:    {human(s['reclaimable_bytes'])}")
    print(f"already hardlinked:   {s.get('already_hardlinked', 0)}")
    print(f"hashed (partial/full): {s.get('partial_hashed', 0)} / {s.get('full_hashed', 0)}")
    print(f"cuckoo filter:        load {s['filter_load_factor']}, "
          f"{s.get('filter_false_positives', 0)} false positives, "
          f"{s.get('filter_rebuilds', 0)} rebuilds")
    if a.verbose:
        for g in d.groups:
            print(f"\n[{human(g.keep.size)}] keep: {g.keep.path}")
            for x in g.verified:
                print("   dup:", x.path)
            for x in g.failed:
                print("   FAILED VERIFY:", x.path)
    if d.actions:
        done = sum(1 for r in d.actions if r["done"])
        label = "applied" if a.apply else "would apply (dry run, add --apply)"
        print(f"\n{a.action}: {label} -> {done if a.apply else len(d.actions)} files")
        for r in d.actions:
            if a.apply and not r["done"]:
                print("   skipped", r["dup"], "-", r["note"])
            elif a.verbose and not a.apply:
                print("   ", a.action, r["dup"])
    if a.report:
        write_report(a.report, d.report())
        print("report written to", a.report)
    return 1 if (s["failed_verification"] or d.errors) else 0


def cmd_manifest(a):
    cache = load_json(a.cache, {}) if a.cache else {}
    m = build_manifest(a.folders, a.exclude, a.threads, cache)
    save_json(a.output, m)
    if a.cache:
        save_json(a.cache, cache)
    print(f"manifest with {len(m['files'])} files written to {a.output}")
    return 0


def cmd_verify(a):
    manifest = load_json(a.manifest, None)
    if not manifest:
        print("could not read manifest", a.manifest)
        return 2
    r = verify_manifest(manifest, a.folders, a.exclude, a.threads, fast=a.fast)
    print(f"ok: {len(r['ok'])}   modified: {len(r['modified'])}   corrupted: {len(r['corrupted'])}   "
          f"missing: {len(r['missing'])}   new: {len(r['new'])}   moved: {len(r['moved'])}")
    for key in ("corrupted", "modified", "missing", "new"):
        for p in r[key]:
            print(f"  {key.upper():9} {p}")
    for old, new in r["moved"]:
        print(f"  MOVED     {old} -> {new}")
    return 1 if (r["corrupted"] or r["modified"] or r["missing"]) else 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="file deduplication + verification (cuckoo filter)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p, cache=True):
        p.add_argument("--exclude", action="append", default=[], help="glob, can repeat (e.g. '*.tmp')")
        p.add_argument("--threads", type=int, default=4)
        if cache:
            p.add_argument("--cache", help="json file that remembers hashes between runs")

    s = sub.add_parser("scan", help="find duplicates")
    s.add_argument("folders", nargs="+")
    common(s)
    s.add_argument("--action", choices=["report", "delete", "hardlink", "symlink", "move"], default="report")
    s.add_argument("--apply", action="store_true", help="actually do the action (default is dry run)")
    s.add_argument("--keep", choices=["oldest", "newest", "shortest", "first"], default="oldest")
    s.add_argument("--min-size", type=int, default=1, help="ignore files smaller than this many bytes")
    s.add_argument("--quarantine", default="dedup_quarantine", help="folder for --action move")
    s.add_argument("--capacity", type=int, default=100_000, help="starting cuckoo filter size")
    s.add_argument("--report", help="write results to .json or .csv")
    s.add_argument("-v", "--verbose", action="store_true")
    s.add_argument("-q", "--quiet", action="store_true")
    s.set_defaults(func=cmd_scan)

    m = sub.add_parser("manifest", help="record hashes of every file")
    m.add_argument("folders", nargs="+")
    m.add_argument("-o", "--output", default="manifest.json")
    common(m)
    m.set_defaults(func=cmd_manifest)

    v = sub.add_parser("verify", help="check files against a manifest")
    v.add_argument("manifest")
    v.add_argument("folders", nargs="+")
    v.add_argument("--fast", action="store_true", help="trust size+mtime instead of rehashing")
    common(v, cache=False)
    v.set_defaults(func=cmd_verify)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())